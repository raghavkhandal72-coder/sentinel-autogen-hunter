# ==============================================================================
# Sentinel-AutoGen-Hunter Environment Configuration
# ==============================================================================

# Execution Mode: "mock" (offline zero-cost) or "live" (using real LLMs)
HUNTER_MODE=mock

# Primary LLM API Keys (OpenAI / Azure OpenAI / Gemini)
LLM_API_KEY=mock_key_for_testing
LLM_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Cyber Threat Intelligence (AbuseIPDB / Shodan)
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Enterprise Notifications (Microsoft Teams / Slack)
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Microsoft Sentinel / Azure Log Analytics Workspace
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
SENTINEL_LOG_TYPE=AutoGenThreatHunt_CL

# Zero-Trust Host Firewall Bridge
ACTION_LOG_PATH=/app/actions/pending_blocks.log
ORCHESTRATOR_URL=http://ai-orchestrator:8000/analyze
LOG_LEVEL=INFO

# Autonomous Multi-Repo GitHub Crawler
GITHUB_TOKEN=insert_github_pat_token_here

# High-Reasoning LLM (NVIDIA NIM / DeepSeek / Meta Llama)
NVIDIA_NIM_API_KEY=insert_nvidia_nim_key_here

# Microsoft Sentinel Logs Ingestion API (DCE / DCR)
AZURE_TENANT_ID=insert_tenant_id_here
AZURE_CLIENT_ID=insert_client_id_here
AZURE_CLIENT_SECRET=insert_client_secret_here
AZURE_DCE_ENDPOINT=https://your-dce-endpoint.eastus-1.ingest.monitor.azure.com
AZURE_DCR_RULE_ID=dcr-1234567890abcdef1234567890abcdef
AZURE_DCR_STREAM_NAME=Custom-AutoGenThreatLogs_CL

