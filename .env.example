# ==============================================================================
# Sentinel-AutoGen-Hunter Environment Configuration
# ==============================================================================

# Execution Mode: "mock" (offline zero-cost) or "live" (using real LLMs)
HUNTER_MODE=mock

# Primary LLM API Keys (OpenAI / Azure OpenAI / Gemini)
LLM_API_KEY=mock_key_for_testing
LLM_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Cyber Threat Intelligence (AbuseIPDB / Shodan)
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Enterprise Notifications (Microsoft Teams / Slack)
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Microsoft Sentinel / Azure Log Analytics Workspace
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
SENTINEL_LOG_TYPE=AutoGenThreatHunt_CL

# Zero-Trust Host Firewall Bridge
ACTION_LOG_PATH=/app/actions/pending_blocks.log
ORCHESTRATOR_URL=http://ai-orchestrator:8000/analyze
LOG_LEVEL=INFO
