<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sentinel.hunter</groupId>
  <artifactId>sentinel-autogen-hunter</artifactId>
  <version>1.4.1</version>
  <packaging>jar</packaging>

  <name>Sentinel-AutoGen-Hunter Java SDK</name>
  <description>Enterprise Java SDK for Sentinel-AutoGen-Hunter Threat Hunting &amp; Deception Mesh</description>
  <url>https://github.com/raghavkhandal72-coder/sentinel-autogen-hunter</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>raghavkhandal72</id>
      <name>Raghav Khandal</name>
      <email>raghavkhandal72@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/raghavkhandal72-coder/sentinel-autogen-hunter.git</connection>
    <developerConnection>scm:git:ssh://github.com:raghavkhandal72-coder/sentinel-autogen-hunter.git</developerConnection>
    <url>https://github.com/raghavkhandal72-coder/sentinel-autogen-hunter</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/raghavkhandal72-coder/sentinel-autogen-hunter</url>
    </repository>
  </distributionManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>11</source>
          <target>11</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
